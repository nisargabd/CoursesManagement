# ---- Build Stage ----
FROM eclipse-temurin:17-jdk-jammy AS build
WORKDIR /app

# Install SBT
RUN apt-get update && apt-get install -y curl && \
    curl -L -o sbt-1.9.9.deb https://repo.scala-sbt.org/scalasbt/debian/sbt-1.9.9.deb && \
    dpkg -i sbt-1.9.9.deb && \
    rm sbt-1.9.9.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy build definition first to cache dependencies
COPY build.sbt .
COPY project project
RUN sbt update

# Copy the rest of the source code
COPY . .
RUN sbt dist

# ---- Runtime Stage ----
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Install unzip
RUN apk add --no-cache unzip

# Copy the build artifact from the build stage
COPY --from=build /app/target/universal/course-backend-1.0.0.zip .

# Unzip and clean up
RUN unzip course-backend-1.0.0.zip && rm course-backend-1.0.0.zip

# Expose the configured port
EXPOSE 9099

# Start the application
# -Dplay.http.secret.key should be overridden in production/k8s secrets
# -Dhttp.port=9099 ensures it listens on the port expected by the k8s service
ENTRYPOINT ["./course-backend-1.0.0/bin/course-backend", "-Dplay.http.secret.key=changeme", "-Dhttp.port=9099"]
